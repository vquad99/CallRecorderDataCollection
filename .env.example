# Copy to .env and change every value marked change-me. Never commit .env.
# Names and safe example values only (FND-025).

# Backend (when run on the host with `make backend`)
APP_ENV=development
# Super Admin and Project Admin accounts must set up two-step sign-in before anything else
# (D-106). Unset: required everywhere except development and test. Set true to try it here.
#REQUIRE_ADMIN_MFA=true
SECRET_KEY=change-me-change-me-change-me-change-me-0000
# Encryption key for sensitive fields. Generate one with `make key`; the example value is rejected.
DATA_ENCRYPTION_KEY=change-me-run-make-key
PUBLIC_APP_URL=http://localhost:5173
# Development email goes to files in EMAIL_FILE_DIR; production needs EMAIL_BACKEND=smtp + SMTP_*.
EMAIL_BACKEND=file
EMAIL_FILE_DIR=var/outbox
# File storage (S3 API). Local SeaweedFS from `make deps-up`, or the Wasabi bucket with your own
# prefix. Leave STORAGE_BUCKET empty and recording shows "storage not configured".
STORAGE_ENDPOINT_URL=http://127.0.0.1:8333
STORAGE_BUCKET=ccp-local
STORAGE_ACCESS_KEY_ID=local-dev
STORAGE_SECRET_ACCESS_KEY=change-me-local-dev-secret
STORAGE_CREATE_BUCKET=true
STORAGE_KEY_PREFIX=
# Password for the development demo accounts created by `make seed-dev`.
DEMO_PASSWORD=change-me-demo-password
DATABASE_URL=postgresql+psycopg://ccp:change-me-local-db-password@127.0.0.1:5433/ccp
REDIS_URL=redis://127.0.0.1:6380/0
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# Tests: a database whose name ends in _test (created by infra/postgres/init)
TEST_DATABASE_URL=postgresql+psycopg://ccp:change-me-local-db-password@127.0.0.1:5433/ccp_test

# Docker Compose (infra/docker-compose.yml)
POSTGRES_PASSWORD=change-me-local-db-password
DB_PORT=5433
REDIS_PORT=6380
STORAGE_PORT=8333
BACKEND_PORT=8000
WEB_PORT=8080

# Recovery of half-done recordings (docs/DEPLOYMENT.md section 5)
PROCESSING_PICKUP_SECONDS=60
PROCESSING_STALE_MINUTES=15
RECOVERY_INTERVAL_SECONDS=60
# Export bundles (D-105): hours a prepared export stays in storage; minutes after which an export
# that stopped half-way is tried again; seconds a waiting export is left before it is sent to a
# worker again.
EXPORT_BUNDLE_HOURS=24
EXPORT_STALE_MINUTES=60
EXPORT_REQUEUE_SECONDS=120

# Scaling (docs/DEPLOYMENT.md section 5): web processes, processing slots per worker container,
# database connections per web process (pool + overflow). Staff-account capacity is a setting in the
# app (Settings, capacity targets), not here.
WEB_CONCURRENCY=1
WORKER_CONCURRENCY=2
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Monitoring (docs/DEPLOYMENT.md section 5): slow answers become warnings in the log (0 = off)
SLOW_REQUEST_MS=1000
SLOW_QUERY_MS=250
# Dashboards count calendar days in this IANA time zone.
REPORT_TIMEZONE=Asia/Kolkata
# Days a participant's personal page link works before staff must issue a new one.
PORTAL_LINK_DAYS=30
# Web server: where recordings play from (Content-Security-Policy media-src)
MEDIA_ORIGINS=https://*.wasabisys.com

# Phone calls through TxContact (D-101). Leave the logins empty and phone calls show
# "Not configured". The dialer and the recording service have separate logins. Never commit them.
TXCONTACT_BASE_URL=https://amber.txcontact.com
TXCONTACT_CAMPAIGN_REF=dc-record-call
TXCONTACT_DIALER_USERNAME=
TXCONTACT_DIALER_PASSWORD=
TXCONTACT_RECORD_USER=
TXCONTACT_RECORD_PASSWORD=
# Word before the token in the Authorization header (TxContact has not said which; NOT VERIFIED).
TXCONTACT_AUTH_SCHEME=Token
# Time zone of the times TxContact reports.
TXCONTACT_TIMEZONE=Asia/Kolkata
# Minutes to keep looking for a closed call's recording before asking a person.
TELEPHONY_FETCH_MINUTES=60
# Seconds to wait after a call is closed before the first look for its recording.
TELEPHONY_FIRST_LOOK_SECONDS=30
# A task (one participant's phone) is called at most this many times in an hour.
TELEPHONY_MAX_CALLS_PER_TASK_PER_HOUR=6
