# Copy to .env and change every value marked change-me. Never commit .env.
# Names and safe example values only (FND-025).

# Backend (when run on the host with `make backend`)
APP_ENV=development
SECRET_KEY=change-me-change-me-change-me-change-me-0000
# Encryption key for sensitive fields. Generate one with `make key`; the example value is rejected.
DATA_ENCRYPTION_KEY=change-me-run-make-key
PUBLIC_APP_URL=http://localhost:5173
# Development email goes to files in EMAIL_FILE_DIR; production needs EMAIL_BACKEND=smtp + SMTP_*.
EMAIL_BACKEND=file
EMAIL_FILE_DIR=var/outbox
# File storage (S3 API). Local SeaweedFS from `make deps-up`, or the Wasabi bucket with your own
# prefix. Leave STORAGE_BUCKET empty and recording shows "storage not configured".
STORAGE_ENDPOINT_URL=http://127.0.0.1:8333
STORAGE_BUCKET=ccp-local
STORAGE_ACCESS_KEY_ID=local-dev
STORAGE_SECRET_ACCESS_KEY=change-me-local-dev-secret
STORAGE_CREATE_BUCKET=true
STORAGE_KEY_PREFIX=
# Password for the development demo accounts created by `make seed-dev`.
DEMO_PASSWORD=change-me-demo-password
DATABASE_URL=postgresql+psycopg://ccp:change-me-local-db-password@127.0.0.1:5433/ccp
REDIS_URL=redis://127.0.0.1:6380/0
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# Tests: a database whose name ends in _test (created by infra/postgres/init)
TEST_DATABASE_URL=postgresql+psycopg://ccp:change-me-local-db-password@127.0.0.1:5433/ccp_test

# Docker Compose (infra/docker-compose.yml)
POSTGRES_PASSWORD=change-me-local-db-password
DB_PORT=5433
REDIS_PORT=6380
STORAGE_PORT=8333
BACKEND_PORT=8000
WEB_PORT=8080
