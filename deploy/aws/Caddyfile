# TLS front for the AWS server (D-096). Cloudflare stays in front of the site: the visitor's address
# is taken from CF-Connecting-IP only when the request really comes from Cloudflare (ranges below,
# https://www.cloudflare.com/ips/), then handed to nginx in X-Real-IP. A request straight to the
# server's address cannot choose the address it is counted under.
#
# TLS (set in .env):
#   TLS=internal                                   Caddy's own certificate; Cloudflare SSL mode "Full"
#   TLS=/certs/origin.pem /certs/origin.key        Cloudflare Origin Certificate; mode "Full (strict)"
{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

{$SITE_ADDRESS} {
	tls {$TLS}
	reverse_proxy web:8080 {
		header_up X-Real-IP {client_ip}
		# Exports are sent while they are made; pass each part on at once.
		flush_interval -1
	}
}
