# Settings for the AWS server (D-096). Copy to deploy/aws/.env (chmod 600). Never commit .env.
# Values marked COPY are the same as on Render today (Render dashboard -> ccp-api -> Environment).

# --- site
SITE_ADDRESS=dubdesk.live
PUBLIC_APP_URL=https://dubdesk.live
# internal = Caddy's own certificate (Cloudflare SSL mode "Full"); see Caddyfile for the other way
TLS=internal

# --- database (new; hex only so it is safe inside a URL: openssl rand -hex 24)
POSTGRES_PASSWORD=

# --- keys: COPY. DATA_ENCRYPTION_KEY must be the Render one or stored phone numbers are unreadable.
SECRET_KEY=
DATA_ENCRYPTION_KEY=

# --- file storage
# Wasabi (as now; nothing to move):
STORAGE_ENDPOINT_URL=https://s3.ap-southeast-1.wasabisys.com
STORAGE_REGION=ap-southeast-1
STORAGE_BUCKET=callrec57
STORAGE_KEY_PREFIX=staging/
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
MEDIA_ORIGINS=https://callrec57.s3.ap-southeast-1.wasabisys.com
# AWS S3 instead (after copying the files, README step 8): DELETE the STORAGE_ENDPOINT_URL line
# (an empty value is not "unset"), set STORAGE_BUCKET=<bucket>, STORAGE_REGION=ap-southeast-1, the
# S3 keys, keep STORAGE_KEY_PREFIX=staging/, and
# MEDIA_ORIGINS=https://<bucket>.s3.ap-southeast-1.amazonaws.com

# --- mail (Resend SMTP): COPY
EMAIL_BACKEND=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=

# --- first Super Admin (only used when no admin exists yet): COPY
ADMIN_EMAIL=
ADMIN_PASSWORD=
ALLOW_DEMO_SEED=false

# --- size
WEB_CONCURRENCY=2
WORKER_CONCURRENCY=2
