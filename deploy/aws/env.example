# Settings for the AWS server (D-132). On the server, as the ccp user: copy to deploy/aws/.env,
# chmod 600, fill in (docs/DEPLOYMENT_AWS.md step 6). Never commit .env.
# One setting per line, no spaces around "=". Put a value that contains $ in single quotes ('...'),
# or Docker Compose reads it as a variable.
#   RENDER:    copy the value from Render (dashboard > ccp-api > Environment)
#   TERRAFORM: from `terraform output` in infra/aws (output env_lines has most of them)
# CI's aws-stack job starts the stack from this file with dummy secrets and the stand-in database.

# --- site
SITE_ADDRESS=dubdesk.live
# Links in emails are built from it.
PUBLIC_APP_URL=https://dubdesk.live
# Certificate Caddy shows (deploy/aws/Caddyfile). Production with Cloudflare in front:
# TLS=/certs/origin.pem /certs/origin.key   (the Origin Certificate files in deploy/aws/certs/)
TLS=internal

# --- database: RDS. TERRAFORM: rds_endpoint; POSTGRES_PASSWORD = terraform output -raw db_password.
# Empty DB_HOST = a stand-in database container (CI and trials only; deploy.sh refuses it otherwise).
DB_HOST=
DB_PORT=5432
DB_NAME=ccp
DB_USER=ccp
POSTGRES_PASSWORD=

# --- keys: RENDER. DATA_ENCRYPTION_KEY must be Render's, or stored phone numbers, participants'
# emails and two-step secrets cannot be read. SECRET_KEY must be Render's too: phone numbers are
# matched (duplicates found) by a hash made with it.
SECRET_KEY=
DATA_ENCRYPTION_KEY=

# --- file storage: the S3 bucket in Mumbai. TERRAFORM: bucket_name.
STORAGE_ENDPOINT_URL=https://s3.ap-south-1.amazonaws.com
STORAGE_REGION=ap-south-1
STORAGE_BUCKET=ccp-recordings-ACCOUNT-ID
# Kept: every stored file lives under it (D-081), and the copy keeps the same keys.
STORAGE_KEY_PREFIX=staging/
# Empty = the server's own role, no keys stored (docs/DEPLOYMENT_AWS.md section 9). Keep them empty.
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# --- mail: Resend SMTP. RENDER.
EMAIL_BACKEND=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
# Who gets the platform's own alerts, comma-separated (D-109). RENDER (set on ccp-api there).
ALERT_EMAIL=

# --- accounts
# Two-step sign-in for Super Admins and Project Admins (D-106).
REQUIRE_ADMIN_MFA=true
# First Super Admin, made only when none exists. Leave both empty: the copied database has one.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ALLOW_DEMO_SEED=false

# --- phone calls: TxContact (D-101). Logins: RENDER. Empty logins = phone calls "Not configured".
TXCONTACT_BASE_URL=https://amber.txcontact.com
TXCONTACT_CAMPAIGN_REF=dc-new-call
TXCONTACT_ATTACH_CAMPAIGN_REF=dc-attach-call
TXCONTACT_DIALER_USERNAME=
TXCONTACT_DIALER_PASSWORD=
TXCONTACT_RECORD_USER=
TXCONTACT_RECORD_PASSWORD=
# TxContact's times run 5 h 30 min ahead of the real time (D-131).
TXCONTACT_CLOCK_AHEAD_MINUTES=330

# --- container logs to CloudWatch. TERRAFORM: log_group_app (/ccp/app). Empty = logs stay on the
# server only (CI).
AWS_LOG_GROUP=
AWS_REGION=ap-south-1

# --- size (t3.medium: 2 CPUs, 4 GB)
WEB_CONCURRENCY=2
WORKER_CONCURRENCY=2
